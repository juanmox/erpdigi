# Copiar a /etc/superset/superset.env (propietario root, grupo superset, modo 640).
# NUNCA commitear el archivo real. Generar cada secreto con:  openssl rand -base64 48
SUPERSET_SECRET_KEY=
SUPERSET_DB_PASSWORD=
SUPERSET_DB_HOST=localhost
GUEST_TOKEN_JWT_SECRET=
# Dirección desde la que el NAVEGADOR abre el ERP (CSP frame-ancestors y dominios permitidos).
ERP_ORIGEN=http://192.168.2.13
SCARF_ANALYTICS=false
