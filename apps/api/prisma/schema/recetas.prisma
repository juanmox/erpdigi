model AreaUso {
  idArea          Int              @id @default(autoincrement()) @map("id_area")
  nombre          String           @unique @db.VarChar(60)

  desarrolloInsumos DesarrolloInsumo[]

  @@map("areas_uso")
  @@schema("recetas")
}

model CategoriaInsumo {
  idCategoria Int      @id @default(autoincrement()) @map("id_categoria")
  nombre      String   @unique @db.VarChar(60)
  orden       Int      @default(0)
  insumos     Insumo[]

  @@map("categorias_insumo")
  @@schema("recetas")
}

model Cliente {
  idCliente Int        @id @default(autoincrement()) @map("id_cliente")
  codigo    String     @unique @db.VarChar(20)
  nombre    String     @db.VarChar(150)
  /// Retirar en vez de borrar. Un cliente mal creado solo se podía eliminar, y
  /// eso obliga a repuntar todo su histórico primero; desactivarlo lo saca de
  /// los selectores y del import dejando los datos donde están.
  activo    Boolean    @default(true)
  productos Producto[]

  /// Relaciones inversas del módulo Costeo Real (costeo.prisma) — costeo
  /// referencia este catálogo por FK, no lo duplica (ver docs/02).
  ordenesProduccionCosteo OrdenProduccion[]
  ordenesFacturacionCosteo OrdenFacturacion[]

  desarrollos Desarrollo[]
  subclientes Subcliente[]

  @@map("clientes")
  @@schema("recetas")
}

/// Snapshot de cabecera de un producto congelado al momento de cotizar.
/// División o marca que cuelga de un cliente y NO se factura aparte: la factura
/// va siempre al cliente padre. Nace de Under Armour, que había entrado como
/// cliente (411) por no tener dónde más ir.
///
/// ⚠️ Es por cliente (@@unique([idCliente, nombre])) y no global, al revés que
/// `Estilo`: un tipo de prenda es universal, una división pertenece
/// a su casa matriz.
///
/// `codigo` es lo que permite que la plantilla de Órdenes siga aceptando el
/// `411` que ya traen los archivos armados — el import lo resuelve al cliente
/// padre y lo avisa en el preview. Un código que también exista como cliente
/// haría ambigua esa resolución: el import prefiere el cliente, y la migración
/// aborta si el código sigue vivo en `clientes`.
model Subcliente {
  idSubcliente Int      @id @default(autoincrement()) @map("id_subcliente")
  idCliente    Int      @map("id_cliente")
  codigo       String?  @unique @db.VarChar(20)
  nombre       String   @db.VarChar(150)
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  cliente   Cliente    @relation(fields: [idCliente], references: [idCliente], onDelete: Restrict, onUpdate: Cascade)
  productos Producto[]

  // + SQL: CHECK de nombre/código no vacíos (Prisma no expresa CHECK).
  @@unique([idCliente, nombre])
  @@index([idCliente])
  @@map("subclientes")
  @@schema("recetas")
}

model CotizacionDetalle {
  idDetalle      Int                       @id @default(autoincrement()) @map("id_detalle")
  idCotizacion   Int                       @map("id_cotizacion")
  idProducto     Int?                      @map("id_producto")
  codigoProducto String                    @map("codigo_producto") @db.VarChar(40)
  descripcion    String                    @db.VarChar(250)
  cantidad       Decimal                   @db.Decimal(14, 2)
  costoUnitario  Decimal                   @map("costo_unitario") @db.Decimal(16, 6)
  costoTotal     Decimal                   @map("costo_total") @db.Decimal(16, 4)
  desarrollo     String?                   @db.VarChar(40)
  patron         String?                   @db.VarChar(60)
  tamano         String?                   @db.VarChar(60)
  deporte        String?                   @db.VarChar(60)
  cliente        String?                   @db.VarChar(150)
  precioVenta    Decimal?                  @map("precio_venta") @db.Decimal(12, 2)
  cotizacion     Cotizacion                @relation(fields: [idCotizacion], references: [idCotizacion], onDelete: Cascade, onUpdate: NoAction)
  producto       Producto?                 @relation(fields: [idProducto], references: [idProducto], onDelete: NoAction, onUpdate: NoAction)
  insumos        CotizacionDetalleInsumo[]

  @@index([idCotizacion], map: "idx_detalle_cotizacion")
  @@map("cotizacion_detalle")
  @@schema("recetas")
}

/// Snapshot de una línea de insumo (o de la fila sintética de mano de obra) dentro de una cotización.
model CotizacionDetalleInsumo {
  idCdi          Int               @id @default(autoincrement()) @map("id_cdi")
  idDetalle      Int               @map("id_detalle")
  idInsumo       Int?              @map("id_insumo")
  codigo         String?           @db.VarChar(30)
  descripcion    String            @db.VarChar(250)
  categoria      String            @db.VarChar(60)
  ordenCategoria Int               @default(0) @map("orden_categoria")
  unidad         String?           @db.VarChar(40)
  area           String?           @db.VarChar(60)
  consumo        Decimal           @db.Decimal(14, 6)
  costoPromedio  Decimal           @map("costo_promedio") @db.Decimal(14, 6)
  costoTotal     Decimal           @map("costo_total") @db.Decimal(16, 6)
  esManoObra     Boolean           @default(false) @map("es_mano_obra")
  detalle        CotizacionDetalle @relation(fields: [idDetalle], references: [idDetalle], onDelete: Cascade, onUpdate: NoAction)

  @@index([idDetalle], map: "idx_cdi_detalle")
  @@map("cotizacion_detalle_insumo")
  @@schema("recetas")
}

model Cotizacion {
  idCotizacion  Int                 @id @default(autoincrement()) @map("id_cotizacion")
  folio         String?             @unique @db.VarChar(20)
  fechaCreacion DateTime            @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  totalCantidad Decimal             @default(0) @map("total_cantidad") @db.Decimal(14, 2)
  totalCosto    Decimal             @default(0) @map("total_costo") @db.Decimal(16, 4)
  notas         String?
  moneda        String              @default("GTQ") @db.VarChar(3)
  tasaCambio    Decimal?            @map("tasa_cambio") @db.Decimal(12, 6)
  detalle       CotizacionDetalle[]

  @@map("cotizaciones")
  @@schema("recetas")
}

model Deporte {
  idDeporte Int    @id @default(autoincrement()) @map("id_deporte")
  nombre    String @unique @db.VarChar(60)

  @@map("deportes")
  @@schema("recetas")
}

/// Tipo de prenda (Jersey, Short, T-Shirt, Pants…). Antes `costeo.LineaProducto`:
/// se movió acá y se renombró el 2026-10-23, porque en el archivo de campos la
/// LÍNEA es otra cosa (la línea comercial, ver `Linea`). Mismos ids, así que
/// las órdenes que ya lo traían siguen apuntando.
///
/// Catálogo GLOBAL, no por cliente: un Jersey es un Jersey para cualquiera.
/// Vive en el PRODUCTO; el de la orden (`OrdenProduccion.idEstilo`) es histórico.
/// + SQL: UNIQUE (lower(nombre)) y CHECK de nombre no vacío — Prisma no los
/// expresa; el `@unique` de acá solo cubre la forma exacta.
model Estilo {
  idEstilo Int      @id @default(autoincrement()) @map("id_estilo")
  nombre   String   @unique @db.VarChar(80)
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  productos Producto[]

  /// Relaciones inversas del módulo Costeo Real (costeo.prisma).
  ordenesProduccionCosteo OrdenProduccion[]
  plantillasInsumoCosteo  PlantillaInsumo[]

  @@map("estilos")
  @@schema("recetas")
}

/// Línea comercial del producto (Hail Mary, Mesh Crew Neck, V-Neck…). No es el
/// estilo. + SQL: UNIQUE (lower(nombre)) y CHECK de nombre no vacío.
model Linea {
  idLinea  Int      @id @default(autoincrement()) @map("id_linea")
  nombre   String   @unique @db.VarChar(80)
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  productos Producto[]

  @@map("lineas")
  @@schema("recetas")
}

/// Género/público del producto. Nace VACÍO a propósito: las ~80 variantes del
/// legacy ("ADULTO", "MENS", "CABALLERO"…) se mapean a mano antes de cargar.
/// + SQL: UNIQUE (lower(nombre)) y CHECK de nombre no vacío.
model Genero {
  idGenero Int      @id @default(autoincrement()) @map("id_genero")
  nombre   String   @unique @db.VarChar(80)
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  productos Producto[]

  @@map("generos")
  @@schema("recetas")
}

/// Composición de la tela del producto (100% Polyester…).
/// + SQL: UNIQUE (lower(nombre)) y CHECK de nombre no vacío.
model Composicion {
  idComposicion Int      @id @default(autoincrement()) @map("id_composicion")
  nombre        String   @unique @db.VarChar(120)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  productos Producto[]

  @@map("composiciones")
  @@schema("recetas")
}

model Insumo {
  idInsumo        Int              @id @default(autoincrement()) @map("id_insumo")
  codigo          String           @unique @db.VarChar(30)
  descripcion     String           @db.VarChar(250)
  idCategoria     Int              @map("id_categoria")
  idUnidad        Int              @map("id_unidad")
  costoPromedio   Decimal          @default(0) @map("costo_promedio") @db.Decimal(14, 6)
  activo          Boolean          @default(true)
  categoria       CategoriaInsumo  @relation(fields: [idCategoria], references: [idCategoria], onDelete: NoAction, onUpdate: NoAction)
  unidad          UnidadMedida     @relation(fields: [idUnidad], references: [idUnidad], onDelete: NoAction, onUpdate: NoAction)

  /// Relaciones inversas del módulo Costeo Real (costeo.prisma) — costeo
  /// referencia este catálogo por FK, no lo duplica (ver docs/02, decisión D1).
  reposicionesTelaCosteo        Reposicion[]
  reposicionInsumosCosteo       ReposicionInsumo[]
  costosCosteo                  InsumoCosto[]
  ofInsumoCosteo                OfInsumo[]
  plantillaInsumoDetalleCosteo  PlantillaInsumoDetalle[]

  desarrolloInsumos DesarrolloInsumo[]

  @@map("insumos")
  @@schema("recetas")
}

/// ⚠️ CONGELADA (2026-08-26). El BOM se mudó a recetas.desarrollo_insumos: el
/// dueño de la receta es el Desarrollo, no el Producto. Esta tabla NO se borra
/// —guarda el estado previo, es lo que hace posible el rollback, y 01_erp
/// (todavía en producción) la sigue leyendo—, pero el ERP nuevo ya no le
/// escribe. Ver migración 20260826..._desarrollos_duenos_de_receta.
// model ProductoInsumo ELIMINADO (2026-08-31): la tabla recetas.producto_insumos
// se borró al apagar 01_erp. Estaba congelada desde que el desarrollo pasó a ser
// dueño de la receta, y solo existía como red de seguridad para el legacy.


/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Producto {
  idProducto          Int                 @id @default(autoincrement()) @map("id_producto")
  codigo              String              @unique @db.VarChar(40)
  // Biunívoco con Producto (confirmado 2026-08-20 contra 1,128 filas reales
  // de DataDisev3.xlsx: 88 desarrollos únicos, 88 items únicos, cero
  // excepciones) — un desarrollo es un prototipo que, al aprobarse, se
  // convierte en exactamente un producto.
  //
  // FK real desde 2026-08-31, al apagar 01_erp. Mientras el legacy vivía no se
  // podía poner: escribía esta columna como texto libre en 4 endpoints y la FK
  // los habría roto con 23503. Ahora la integridad la garantiza la base, no
  // solo el backend — antes, un código que no resolviera hacía que el producto
  // apareciera en el catálogo con costo Q0.00 sin ninguna señal.
  //
  // @unique = el 1:1 con Desarrollo (confirmado 2026-08-20 contra 1,128 filas
  // reales de DataDisev3.xlsx: 88 desarrollos únicos, 88 items únicos).
  desarrollo          String              @unique @db.VarChar(40)
  desarrolloRef       Desarrollo          @relation(fields: [desarrollo], references: [codigo], onDelete: Restrict, onUpdate: Cascade)
  patron              String?             @db.VarChar(60)
  descripcion         String              @db.VarChar(250)
  tamano              String?             @db.VarChar(60)
  deporte             String?             @db.VarChar(60)
  idCliente           Int?                @map("id_cliente")
  /// Marca o división del cliente, para segmentar sin romper la facturación
  /// (ver Subcliente). Va acá y no en la orden porque 38 órdenes mezclan
  /// prendas de subcliente con prendas directas del mismo cliente.
  idSubcliente        Int?                @map("id_subcliente")
  /// Atributos para la estadística de producción (archivo "DESGLOSE DE CAMPOS",
  /// 2026-10-23). Catálogos con FK y no texto: el legacy escribía ~80 formas de
  /// 8 géneros. Todos nulos al nacer; ningún producto existente cambió.
  idEstilo            Int?                @map("id_estilo")
  idLinea             Int?                @map("id_linea")
  idGenero            Int?                @map("id_genero")
  idComposicion       Int?                @map("id_composicion")
  precioVenta         Decimal             @default(0) @map("precio_venta") @db.Decimal(12, 2)
  /// ⚠️ LEGACY — no son autoritativos: la mano de obra vive en
  /// Desarrollo.minutosMo / .costoMoMinuto desde 2026-08-26, y nada las lee ni
  /// las escribe desde que se apagó 01_erp. Quedan como columnas muertas; se
  /// pueden borrar en una migración aparte cuando convenga.
  minutosMo           Decimal             @default(0) @map("minutos_mo") @db.Decimal(10, 2)
  costoMoMinuto       Decimal             @default(0.33) @map("costo_mo_minuto") @db.Decimal(10, 4)
  activo              Boolean             @default(true)
  creadoEn            DateTime            @default(now()) @map("creado_en") @db.Timestamptz(6)
  detalleCotizaciones CotizacionDetalle[]
  cliente             Cliente?            @relation(fields: [idCliente], references: [idCliente], onDelete: NoAction, onUpdate: NoAction)
  subcliente          Subcliente?         @relation(fields: [idSubcliente], references: [idSubcliente], onDelete: SetNull, onUpdate: Cascade)
  estilo              Estilo?             @relation(fields: [idEstilo], references: [idEstilo], onDelete: Restrict, onUpdate: Cascade)
  linea               Linea?              @relation(fields: [idLinea], references: [idLinea], onDelete: Restrict, onUpdate: Cascade)
  genero              Genero?             @relation(fields: [idGenero], references: [idGenero], onDelete: Restrict, onUpdate: Cascade)
  composicion         Composicion?        @relation(fields: [idComposicion], references: [idComposicion], onDelete: Restrict, onUpdate: Cascade)

  /// Relaciones inversas del módulo Costeo Real (costeo.prisma).
  consumosEstandarCosteo  ConsumoEstandar[]
  lineasProduccionCosteo  LineaProduccion[]
  consumosPapelCosteo     ConsumoPapel[]

  @@index([idCliente], map: "idx_prod_cliente")
  // + SQL: el índice de id_subcliente es PARCIAL (WHERE IS NOT NULL) porque los
  // productos con subcliente son la minoría; Prisma no expresa índices parciales.
  @@index([codigo(ops: raw("gin_trgm_ops"))], map: "idx_prod_codigo_trgm", type: Gin)
  @@index([desarrollo], map: "idx_prod_desarrollo")
  @@index([descripcion(ops: raw("gin_trgm_ops"))], map: "idx_prod_desc_trgm", type: Gin)
  @@index([patron], map: "idx_prod_patron")
  @@index([tamano], map: "idx_prod_tamano")
  @@map("productos")
  @@schema("recetas")
}

model Talla {
  idTalla Int     @id @default(autoincrement()) @map("id_talla")
  nombre  String  @unique @db.VarChar(10)
  orden   Int     @default(0)
  /// Agregado para el módulo Costeo Real — YOUTH·ADULT·WOMEN·MEN·LADIES_FIT·PANT·NUMERICA·COMBINADA·AJUSTADA (ver docs/02-MODELO-ER-PROPUESTO.md)
  grupo   String? @db.VarChar(20)
  /// Las 13 tallas que concentran el 80.4% del catálogo real de consumo
  /// estándar. Solo agrupa los selectores primero; no participa de ningún
  /// cálculo y se puede reasignar sin desplegar.
  frecuente Boolean @default(false)

  /// Relaciones inversas del módulo Costeo Real (costeo.prisma).
  consumosEstandarCosteo      ConsumoEstandar[]
  lineaProduccionTallasCosteo LineaProduccionTalla[]
  consumosPapelCosteo         ConsumoPapel[]

  desarrollosTallaBase Desarrollo[]

  @@map("tallas")
  @@schema("recetas")
}

model UnidadMedida {
  idUnidad Int      @id @default(autoincrement()) @map("id_unidad")
  nombre   String   @unique @db.VarChar(40)
  insumos  Insumo[]

  @@map("unidades_medida")
  @@schema("recetas")
}

/// Vista de solo lectura. Desde 2026-08-26 se apoya en v_desarrollo_costo: el
/// costo del producto ES el de su desarrollo, así que no pueden divergir.
/// ⚠️ Debe devolver SIEMPRE una fila por producto (incluidos los que no tienen
/// desarrollo) — productos.service.ts:listar() hace JOIN, no LEFT JOIN, contra
/// ella: si un producto perdiera su fila desaparecería del catálogo sin error.
view ProductoCosto {
  idProducto    Int?     @map("id_producto")
  codigo        String?  @db.VarChar(40)
  descripcion   String?  @db.VarChar(250)
  costoInsumos  Decimal? @map("costo_insumos") @db.Decimal
  costoManoObra Decimal? @map("costo_mano_obra") @db.Decimal
  costoUnitario Decimal? @map("costo_unitario") @db.Decimal

  @@map("v_producto_costo")
  @@schema("recetas")
}

/// Vista de solo lectura: costo de un prototipo.
/// costo_unitario = Σ(consumo × costo_promedio) + minutos_mo × costo_mo_minuto.
/// Es la fuente única del costo — v_producto_costo se construye sobre ésta.
view DesarrolloCosto {
  idDesarrollo  Int?     @map("id_desarrollo")
  codigo        String?  @db.VarChar(40)
  costoInsumos  Decimal? @map("costo_insumos") @db.Decimal
  costoManoObra Decimal? @map("costo_mano_obra") @db.Decimal
  costoUnitario Decimal? @map("costo_unitario") @db.Decimal

  @@map("v_desarrollo_costo")
  @@schema("recetas")
}

/// Prototipo de una prenda. Es el dueño PERMANENTE de la receta (BOM) y de la
/// mano de obra, antes y después de aprobarse — un Producto nunca posee receta
/// propia. Al aprobarse se asigna a exactamente un Producto (biunívoco, ver
/// Producto.desarrollo).
model Desarrollo {
  idDesarrollo  Int       @id @default(autoincrement()) @map("id_desarrollo")
  codigo        String    @unique @db.VarChar(40)
  descripcion   String    @db.VarChar(250)
  /// BORRADOR·APROBADO — exactamente dos estados.
  // + SQL: CHECK ("estado" IN ('BORRADOR','APROBADO')) — Prisma no expresa
  //   CHECK sobre VARCHAR; mismo criterio que los enums de costeo.prisma.
  estado        String    @default("BORRADOR") @db.VarChar(20)
  idCliente     Int?      @map("id_cliente")
  /// Talla con la que se calculó el consumo del prototipo (referencia).
  idTallaBase   Int?      @map("id_talla_base")
  minutosMo     Decimal   @default(0) @map("minutos_mo") @db.Decimal(10, 2)
  costoMoMinuto Decimal   @default(0.33) @map("costo_mo_minuto") @db.Decimal(10, 4)
  notas         String?
  /// Nunca borrado físico (convención heredada #4): un desarrollo que ya no se
  /// usa se retira con activo=false. Es ortogonal a `estado`.
  activo        Boolean   @default(true)
  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  /// NULL = creado por la migración inicial (no hay un usuario real al que
  /// atribuirle el backfill de los 1,285 desarrollos históricos).
  creadoPor     Int?      @map("creado_por")
  aprobadoEn    DateTime? @map("aprobado_en") @db.Timestamptz(6)
  aprobadoPor   Int?      @map("aprobado_por")

  cliente   Cliente?           @relation(fields: [idCliente], references: [idCliente], onDelete: NoAction, onUpdate: NoAction)
  tallaBase Talla?             @relation(fields: [idTallaBase], references: [idTalla], onDelete: NoAction, onUpdate: NoAction)
  insumos   DesarrolloInsumo[]
  /// 1:1 real: productos.desarrollo es UNIQUE, así que a lo sumo hay uno.
  /// Prisma lo modela como lista porque la FK apunta a un campo @unique que no
  /// es la PK; la unicidad la garantiza la base.
  productos Producto[]

  @@index([estado], map: "idx_desarrollo_estado")
  @@index([idCliente], map: "idx_desarrollo_cliente")
  @@map("desarrollos")
  @@schema("recetas")
}

/// Línea de receta del desarrollo. Igual que la vieja producto_insumos, es de
/// las pocas tablas con borrado físico permitido (excepción ya aprobada para
/// líneas de receta individuales).
model DesarrolloInsumo {
  idDesarrolloInsumo Int     @id @default(autoincrement()) @map("id_desarrollo_insumo")
  idDesarrollo       Int     @map("id_desarrollo")
  idInsumo           Int     @map("id_insumo")
  consumo            Decimal @default(0) @db.Decimal(14, 6)
  idArea             Int?    @map("id_area")

  desarrollo Desarrollo @relation(fields: [idDesarrollo], references: [idDesarrollo], onDelete: Cascade, onUpdate: NoAction)
  insumo     Insumo     @relation(fields: [idInsumo], references: [idInsumo], onDelete: NoAction, onUpdate: NoAction)
  area       AreaUso?   @relation(fields: [idArea], references: [idArea], onDelete: NoAction, onUpdate: NoAction)

  // + SQL: el índice único real se crea con NULLS NOT DISTINCT — Prisma no lo
  //   expresa. Sin eso (bug real heredado de producto_insumos, ver
  //   aplicarImportarRecetas) dos líneas del mismo insumo SIN área no
  //   colisionan y el ON CONFLICT del import nunca dispara para esas filas:
  //   en vez de actualizar el consumo, duplica la línea.
  @@unique([idDesarrollo, idInsumo, idArea])
  @@index([idDesarrollo], map: "idx_desins_desarrollo")
  @@map("desarrollo_insumos")
  @@schema("recetas")
}
