# Copiar a apps/api/.env (nunca se commitea) y completar valores reales.

# postgresql://usuario:password@host:puerto/basededatos — en dev local:
# postgresql://digitexsa:digitexsa_dev@localhost:5433/digitexsa_erp_dev
# En producción: mismo servidor/base que usa 01_erp (192.168.2.13:5432/erpdb),
# pero con un usuario propio de la app nueva (no reusar erpadmin de 01_erp).
DATABASE_URL=

# Firma de los JWT de acceso. Generar uno propio para producción, distinto del de
# desarrollo: openssl rand -base64 48
JWT_SECRET=

# Puerto donde escucha NestJS. En dev es 4000; en producción usar uno libre en el
# servidor (192.168.2.13 ya tiene 3000 ocupado por 01_erp) — 4001 sugerido.
PORT=4000

# Tipo de cambio de respaldo cuando falla el servicio SOAP de Banguat (mismo
# propósito que TC_FALLBACK en 01_erp/.env — puede copiarse el mismo valor).
TC_FALLBACK=7.61812

# El cookie de refresh token se marca "Secure" automáticamente cuando NODE_ENV=production
# (necesita HTTPS para que el navegador lo reenvíe). Mientras el servidor siga siendo
# solo red interna sin SSL (ver CLAUDE.md), dejar esto en false — si no, nadie puede
# mantener sesión iniciada en producción. Quitar/dejar vacío el día que haya HTTPS.
COOKIE_SECURE=false

# Opcionales — solo los usa `prisma db seed`, para no dejar la contraseña temporal
# por defecto ("CambiarInmediatamente123!") en un ambiente que no sea dev local.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
