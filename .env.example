# Copiar a .env y ajustar valores. Nunca subir el .env real a git.

NODE_ENV=development
PORT=4000

# Desarrollo local: apunta al Postgres de infra/docker/docker-compose.dev.yml
# (puerto 5433, no 5432 — esta máquina ya tiene un Postgres nativo en 5432).
# Producción: apunta al erpdb real del servidor (192.168.2.13), rol erp_core_app
DATABASE_URL="postgresql://digitexsa:digitexsa_dev@localhost:5433/digitexsa_erp_dev"

JWT_SECRET="cambia-este-valor"
JWT_REFRESH_SECRET="cambia-este-otro-valor"
